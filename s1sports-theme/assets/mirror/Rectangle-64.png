	<style id="s1-mobile-athlete-card-fix">
		@media (hover: none), (pointer: coarse) {
			.breakdance .flip-card:hover #flip-card__inner {
				transform: none !important;
			}

			.breakdance .flip-card.s1-card-flipped #flip-card__inner {
				transform: rotateY(180deg) !important;
			}
		}
	</style>
	<script>
		document.addEventListener('click', function (event) {
			if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) {
				return;
			}

			const card = event.target.closest('.flip-card');
			if (!card) {
				return;
			}

			const shouldOpen = !card.classList.contains('s1-card-flipped');

			document.querySelectorAll('.flip-card.s1-card-flipped').forEach(function (openCard) {
				openCard.classList.remove('s1-card-flipped');
			});

			if (shouldOpen) {
				card.classList.add('s1-card-flipped');
			}
		});
	</script>
